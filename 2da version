        "import ipywidgets as widgets\n",
        "from IPython.display import display, clear_output\n",
        "import pandas as pd\n",
        "\n",
        "historial_productos = []\n",
        "titulo = widgets.HTML(\"<h2 style='color: #2c3e50;'> Registro de Productos</h2>\")\n",
        "\n",
        "txt_producto = widgets.Text(\n",
        "    description=\"Producto:\",\n",
        "    placeholder=\"Nombre del producto\",\n",
        "    style={'description_width': '100px'}\n",
        ")\n",
        "\n",
        "txt_precio = widgets.FloatText(\n",
        "    description=\"Precio (Bs):\",\n",
        "    value=0.0,\n",
        "    style={'description_width': '100px'}\n",
        ")\n",
        "\n",
        "txt_cantidad = widgets.IntText(\n",
        "    description=\"Cantidad:\",\n",
        "    value=1,\n",
        "    style={'description_width': '100px'}\n",
        ")\n",
        "\n",
        "btn_registrar = widgets.Button(\n",
        "    description=\"Registrar\",\n",
        "    button_style=\"success\",\n",
        "    icon=\"check\"\n",
        ")\n",
        "\n",
        "btn_limpiar = widgets.Button(\n",
        "    description=\"Limpiar Historial\",\n",
        "    button_style=\"danger\",\n",
        "    icon=\"trash\"\n",
        ")\n",
        "\n",
        "salida = widgets.Output()\n",
        "\n",
        "def registrar_producto(b):\n",
        "    with salida:\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        producto = txt_producto.value.strip()\n",
        "        precio = txt_precio.value\n",
        "        cantidad = txt_cantidad.value\n",
        "\n",
        "        if not producto:\n",
        "            print(\" Error: El nombre del producto no puede estar vacío.\")\n",
        "            return\n",
        "\n",
        "        if precio <= 0 or cantidad <= 0:\n",
        "            print(\" Error: El precio debe ser mayor a 0 y la cantidad al menos 1.\")\n",
        "            return\n",
        "\n",
        "        total = precio * cantidad\n",
        "\n",
        "\n",
        "        historial_productos.append({\n",
        "            \"Producto\": producto,\n",
        "            \"Precio (Bs)\": round(precio, 2),\n",
        "            \"Cantidad\": cantidad,\n",
        "            \"Total (Bs)\": round(total, 2)\n",
        "        })\n",
        "\n",
        "\n",
        "        df = pd.DataFrame(historial_productos)\n",
        "        print(\" ¡PRODUCTO REGISTRADO CON ÉXITO!\\n\")\n",
        "        display(df)\n",
        "\n",
        "\n",
        "        total_general = sum(item[\"Total (Bs)\"] for item in historial_productos)\n",
        "        print(f\"\\n Total General Acumulado: {total_general:.2f} Bs\")\n",
        "\n",
        "\n",
        "        txt_producto.value = \"\"\n",
        "        txt_precio.value = 0.0\n",
        "        txt_cantidad.value = 1\n",
        "\n",
        "def limpiar_historial(b):\n",
        "    global historial_productos\n",
        "    historial_productos = []\n",
        "    with salida:\n",
        "        clear_output(wait=True)\n",
        "        print(\" Historial limpiado correctamente.\")\n",
        "\n",
        "btn_registrar.on_click(registrar_producto)\n",
        "btn_limpiar.on_click(limpiar_historial)\n",
        "\n",
        "\n",
        "botones_box = widgets.HBox([btn_registrar, btn_limpiar])\n",
        "\n",
        "formulario = widgets.VBox([\n",
        "    titulo,\n",
        "    txt_producto,\n",
        "    txt_precio,\n",
        "    txt_cantidad,\n",
        "    botones_box,\n",
        "    salida\n",
        "])\n",
        "\n",
        "display(formulario)"
      ]
