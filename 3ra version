        "import ipywidgets as widgets\n",
        "from IPython.display import display, clear_output\n",
        "import pandas as pd\n",
        "\n",
        "\n",
        "historial_productos = []\n",
        "\n",
        "titulo = widgets.HTML(\n",
        "    \"<h2 style='color: #2c3e50; font-family: sans-serif;'>\"\n",
        "    \" REGISTRO DE PRODUCTOS\"\n",
        "    \"</h2>\"\n",
        ")\n",
        "\n",
        "txt_producto = widgets.Text(\n",
        "    description=\"Producto:\",\n",
        "    placeholder=\"Nombre del producto\",\n",
        "    style={'description_width': '110px'}\n",
        ")\n",
        "\n",
        "txt_precio = widgets.FloatText(\n",
        "    description=\"Precio (Bs):\",\n",
        "    value=0.0,\n",
        "    style={'description_width': '110px'}\n",
        ")\n",
        "\n",
        "txt_cantidad = widgets.IntText(\n",
        "    description=\"Cantidad:\",\n",
        "    value=1,\n",
        "    style={'description_width': '110px'}\n",
        ")\n",
        "btn_registrar = widgets.Button(\n",
        "    description=\"Registrar\",\n",
        "    button_style=\"success\",\n",
        "    icon=\"check\"\n",
        ")\n",
        "\n",
        "btn_limpiar = widgets.Button(\n",
        "    description=\"Limpiar Historial\",\n",
        "    button_style=\"danger\",\n",
        "    icon=\"trash\"\n",
        ")\n",
        "\n",
        "btn_exportar = widgets.Button(\n",
        "    description=\"Exportar a CSV\",\n",
        "    button_style=\"info\",\n",
        "    icon=\"download\"\n",
        ")\n",
        "\n",
        "salida = widgets.Output()\n",
        "\n",
        "\n",
        "def registrar_producto(b):\n",
        "    with salida:\n",
        "        clear_output(wait=True)\n",
        "\n",
        "        producto = txt_producto.value.strip()\n",
        "        precio = txt_precio.value\n",
        "        cantidad = txt_cantidad.value\n",
        "\n",
        "\n",
        "        if not producto:\n",
        "            print(\" Error: Escriba el nombre del producto.\")\n",
        "            return\n",
        "\n",
        "        if precio <= 0 or cantidad <= 0:\n",
        "            print(\" Error: Revise el precio y la cantidad (deben ser mayores a 0).\")\n",
        "            return\n",
        "\n",
        "        total = precio * cantidad\n",
        "\n",
        "\n",
        "        historial_productos.append({\n",
        "            \"Producto\": producto,\n",
        "            \"Precio Unit. (Bs)\": round(precio, 2),\n",
        "            \"Cantidad\": cantidad,\n",
        "            \"Total (Bs)\": round(total, 2)\n",
        "        })\n",
        "\n",
        "\n",
        "        df = pd.DataFrame(historial_productos)\n",
        "\n",
        "        print(\" PRODUCTO REGISTRADO CORRECTAMENTE\\n\")\n",
        "        display(df)\n",
        "\n",
        "        total_acumulado = df[\"Total (Bs)\"].sum()\n",
        "        total_items = df[\"Cantidad\"].sum()\n",
        "\n",
        "        print(\"-\" * 40)\n",
        "        print(f\" Unidades registradas en total: {total_items}\")\n",
        "        print(f\" MONTO TOTAL ACUMULADO: {total_acumulado:.2f} Bs\")\n",
        "        print(\"-\" * 40)\n",
        "\n",
        "\n",
        "        txt_producto.value = \"\"\n",
        "        txt_precio.value = 0.0\n",
        "        txt_cantidad.value = 1\n",
        "\n",
        "\n",
        "def limpiar_historial(b):\n",
        "    global historial_productos\n",
        "    historial_productos = []\n",
        "    with salida:\n",
        "        clear_output(wait=True)\n",
        "        print(\" El historial ha sido borrado.\")\n",
        "\n",
        "\n",
        "def exportar_csv(b):\n",
        "    with salida:\n",
        "        if not historial_productos:\n",
        "            print(\"⚠️ No hay productos guardados para exportar.\")\n",
        "            return\n",
        "\n",
        "        df = pd.DataFrame(historial_productos)\n",
        "        df.to_csv(\"registro_productos.csv\", index=False, encoding=\"utf-8-sig\")\n",
        "        print(\" ¡Archivo 'registro_productos.csv' guardado con éxito!\")\n",
        "\n",
        "\n",
        "btn_registrar.on_click(registrar_producto)\n",
        "btn_limpiar.on_click(limpiar_historial)\n",
        "btn_exportar.on_click(exportar_csv)\n",
        "\n",
        "\n",
        "barra_botones = widgets.HBox([btn_registrar, btn_limpiar, btn_exportar])\n",
        "\n",
        "formulario = widgets.VBox([\n",
        "    titulo,\n",
        "    txt_producto,\n",
        "    txt_precio,\n",
        "    txt_cantidad,\n",
        "    barra_botones,\n",
        "    salida\n",
        "])\n",
        "\n",
        "display(formulario)"
      ]
